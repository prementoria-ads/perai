# Copie para .env e preencha. O .env nunca vai para o Git.
POSTGRES_PASSWORD=

# Chaves dos modelos (D-038). Use limite de gasto em cada fornecedor.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Bot do Telegram (etapa 3). Token criado no @BotFather.
TELEGRAM_BOT_TOKEN=
# Ids de chat que podem usar o bot, separados por vírgula (D-009).
PERAI_TELEGRAM_PERMITIDOS=

# Modelos em uso. Provisório até o resultado do teste comparativo (D-038).
PERAI_MODELO=gemini-flash
# Reservas, em ordem, quando o principal falha (sobrecarga, limite). Apelido ou fornecedor:id,
# separados por vírgula, ex.: google:gemini-3.5-flash,google:gemini-3.1-flash-lite
PERAI_MODELO_RESERVA=
# Raciocínio dos Gemini 3.x no bot: minimal, low, medium, high (vazio = padrão do modelo).
PERAI_RACIOCINIO=low
# Áudio: gemini-audio (chave do Google) ou gpt-mini-transcribe (OpenAI, precisa de crédito)
PERAI_TRANSCRITOR=gemini-audio
PERAI_LEITOR_IMAGEM=gemini-flash

# Google Agenda (D-051). Cliente OAuth "Aplicativo da Web" do projeto Perai no Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave que cifra as autorizações do Google no banco (gerada pelo instalar-agenda.sh).
PERAI_CHAVE_CIFRA=
PERAI_ENDERECO=https://perai.prementoria.com
